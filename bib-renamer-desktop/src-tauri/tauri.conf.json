{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BookNamer",
  "version": "0.1.0",
  "identifier": "com.booknamer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "BookNamer",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Renommage intelligent de fichiers EPUB/PDF",
    "longDescription": "BookNamer enrichit et renomme vos livres et articles (EPUB, PDF) via OpenLibrary, BNF, Amazon, Crossref et Google Books.",
    "copyright": "Copyright © 2026 BookNamer",
    "publisher": "BookNamer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
